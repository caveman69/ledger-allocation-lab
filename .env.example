# Copy to .env (git-ignored) and set a strong password.
# SQL Server requires 8+ characters with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!
MSSQL_PORT=14333

# Connection string the Data.Tests read (LEDGERLAB_SQL). Use 127.0.0.1, not localhost:
# the port is bound to IPv4 only, and on Windows localhost often resolves to IPv6 (::1) first.
# Server=127.0.0.1,14333;Database=LedgerLab;User Id=sa;Password=<same as above>;TrustServerCertificate=True
